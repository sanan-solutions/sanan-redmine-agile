<div id="backlog-complete-modal" class="backlog-complete-modal" hidden
     data-title-template="<%= h l(:label_backlog_complete_title, name: '__NAME__') %>"
     data-summary-template="<%= h l(:text_backlog_complete_summary) %>"
     data-completed-hint="<%= h l(:text_backlog_complete_completed_hint) %>"
     data-open-hint="<%= h l(:text_backlog_complete_open_hint) %>">
  <div class="backlog-complete-modal__backdrop" data-complete-dismiss></div>
  <div class="backlog-complete-modal__dialog" role="dialog" aria-modal="true" aria-labelledby="backlog-complete-title">
    <div class="backlog-complete-modal__hero" aria-hidden="true">
      <div class="backlog-complete-modal__trophy">🏆</div>
    </div>
    <div class="backlog-complete-modal__body">
      <h3 id="backlog-complete-title" class="backlog-complete-modal__title"></h3>
      <p class="backlog-complete-modal__summary" id="backlog-complete-summary"></p>
      <ul class="backlog-complete-modal__hints">
        <li id="backlog-complete-completed-hint"></li>
        <li id="backlog-complete-open-hint"></li>
      </ul>

      <%= form_tag '#', method: :post, id: 'backlog-complete-form', class: 'backlog-complete-modal__form' do %>
        <div class="backlog-complete-modal__dod" id="backlog-complete-dod-wrap" hidden>
          <%= hidden_field_tag :dod_confirmed, '1', id: 'backlog-complete-dod-confirmed', disabled: true %>
          <div class="backlog-complete-modal__dod-head">
            <label><%= l(:label_backlog_complete_dod) %></label>
            <button type="button"
                    class="backlog-complete-modal__dod-all"
                    id="backlog-complete-dod-all"
                    data-label-all="<%= h l(:label_backlog_complete_dod_all) %>"
                    data-label-none="<%= h l(:label_backlog_complete_dod_none) %>">
              <%= l(:label_backlog_complete_dod_all) %>
            </button>
          </div>
          <p class="backlog-complete-modal__dod-hint"><%= l(:text_backlog_complete_dod_hint) %></p>
          <ul class="backlog-complete-modal__dod-list" id="backlog-complete-dod-list"></ul>
          <div class="backlog-complete-modal__actual" id="backlog-complete-actual">
            <span><%= l(:label_backlog_complete_actual) %>
              <strong id="backlog-complete-actual-sp">0</strong>
            </span>
            <span>BE <strong id="backlog-complete-actual-be">0</strong></span>
            <span>FE <strong id="backlog-complete-actual-fe">0</strong></span>
            <span>QA <strong id="backlog-complete-actual-qa">0</strong></span>
          </div>
        </div>

        <div class="backlog-complete-modal__goal">
          <label><%= l(:label_sprint_report_goal_met) %></label>
          <div class="backlog-complete-modal__goal-opts">
            <label>
              <%= radio_button_tag :goal_met, 'met', false %>
              <%= l(:label_sprint_report_goal_met_met) %>
            </label>
            <label>
              <%= radio_button_tag :goal_met, 'partial', false %>
              <%= l(:label_sprint_report_goal_met_partial) %>
            </label>
            <label>
              <%= radio_button_tag :goal_met, 'missed', false %>
              <%= l(:label_sprint_report_goal_met_missed) %>
            </label>
            <label>
              <%= radio_button_tag :goal_met, 'unreviewed', true %>
              <%= l(:label_sprint_report_goal_met_unreviewed) %>
            </label>
          </div>
          <label for="backlog-complete-goal-note"><%= l(:label_sprint_report_goal_note) %></label>
          <%= text_area_tag :goal_note, '', rows: 2, id: 'backlog-complete-goal-note' %>
        </div>

        <div class="backlog-complete-modal__move" id="backlog-complete-move-wrap">
          <label for="backlog-complete-move-to"><%= l(:label_backlog_move_open_items_to) %></label>
          <select name="move_unfinished_to" id="backlog-complete-move-to" class="backlog-complete-modal__select"></select>
        </div>

        <div class="backlog-complete-modal__footer">
          <button type="button" class="backlog-btn backlog-btn--ghost" data-complete-dismiss>
            <%= l(:button_cancel) %>
          </button>
          <%= submit_tag l(:button_backlog_complete_sprint), class: 'backlog-btn backlog-btn--primary' %>
        </div>
      <% end %>
    </div>
  </div>
</div>
