<% html_title "#{l(:label_sprint_report)}: #{@version.name}" %>
<%= stylesheet_link_tag 'sprint_report', plugin: 'sanan_redmine_agile' %>
<% if @history.present? %>
<script>
  window.SANAN_SPRINT_CHARTS = <%= raw sprint_report_chart_payload(@history, @report).to_json %>;
</script>
<% end %>
<%= javascript_include_tag 'chart.umd.min', plugin: 'sanan_redmine_agile' %>
<%= javascript_include_tag 'sprint_report_charts', plugin: 'sanan_redmine_agile' %>

<div class="sanan-sprint-report">
  <header class="sr-page-head">
    <div class="sr-page-head__main">
      <h2><%= l(:label_sprint_report) %>: <%= h @version.name %></h2>
      <div class="sr-meta">
        <span class="sr-badge sr-badge--<%= @version.status %>"><%= l("version_status_#{@version.status}") rescue @version.status %></span>
        <% dates = sprint_report_dates(@version) %>
        <% if dates.present? %>
          <span class="sr-meta__dates"><%= dates %></span>
        <% end %>
        <span class="sr-meta__flag"><%= @report.from_snapshot ? l(:label_sprint_report_from_snapshot) : l(:label_sprint_report_live) %></span>
        <%= sprint_report_goal_met_badge(@report.goal_met) %>
        <% if @version.status.to_s == 'open' && @report.commit_cutoff_on %>
          <% if @report.commit_locked %>
            <span class="sr-badge sr-badge--locked"><%= l(:label_sanan_commit_locked) %></span>
          <% else %>
            <span class="sr-badge"><%= l(:label_sanan_commit_lock_until, date: format_date(@report.commit_cutoff_on)) %></span>
          <% end %>
        <% end %>
      </div>
      <section class="sr-goal">
        <h3><%= l(:label_backlog_sprint_goal) %></h3>
        <% if @version.description.present? %>
          <div class="wiki sr-description"><%= textilizable @version, :description %></div>
        <% else %>
          <p class="sr-empty"><%= l(:label_sprint_report_goal_empty) %></p>
        <% end %>
        <% if @report.goal_note.present? %>
          <p class="sr-hint"><%= l(:label_sprint_report_goal_note) %>: <%= h @report.goal_note %></p>
        <% end %>
      </section>
      <p class="sr-participants">
        <strong><%= l(:label_sprint_report_participants) %>:</strong>
        <%= l(:label_sprint_report_participant_count, count: @report.participants.size) %>
        <% if @report.participants.any? %>
          <span class="sr-participant-list">
            <%= safe_join(@report.participants.map { |u| link_to_user(u) }, ', '.html_safe) %>
          </span>
        <% else %>
          <em><%= l(:label_sprint_report_no_participants) %></em>
        <% end %>
      </p>
    </div>
    <div class="sr-page-head__actions">
      <%= link_to l(:label_backlog), project_backlog_path(@project), class: 'sr-action' if User.current.allowed_to?(:view_backlog, @project) %>
      <% if sprint_report_agile_metrics_available?(@project) %>
        <%= link_to l(:label_agile_metrics),
              sprint_report_agile_metrics_path_for(@project, @version),
              class: 'sr-action' %>
      <% end %>
      <%= link_to l(:label_version), version_path(@version), class: 'sr-action' %>
    </div>
  </header>

  <div class="sr-metrics">
    <section class="sr-card">
      <h3><%= l(:label_sprint_report_commit) %></h3>
      <div class="sr-kpis">
        <div class="sr-kpi sr-kpi--total">
          <span class="sr-kpi__label"><%= l(:label_sprint_report_sp) %></span>
          <span class="sr-kpi__value"><%= sprint_report_number(@report.commit_sp) %></span>
        </div>
        <div class="sr-kpi">
          <span class="sr-kpi__label"><%= l(:label_sprint_report_sp_be) %></span>
          <span class="sr-kpi__value"><%= sprint_report_number(@report.commit_be) %></span>
        </div>
        <div class="sr-kpi">
          <span class="sr-kpi__label"><%= l(:label_sprint_report_sp_fe) %></span>
          <span class="sr-kpi__value"><%= sprint_report_number(@report.commit_fe) %></span>
        </div>
        <div class="sr-kpi">
          <span class="sr-kpi__label"><%= l(:label_sprint_report_sp_qa) %></span>
          <span class="sr-kpi__value"><%= sprint_report_number(@report.commit_qa) %></span>
        </div>
      </div>
    </section>

    <section class="sr-card">
      <h3><%= l(:label_sprint_report_actual) %></h3>
      <div class="sr-kpis">
        <%# Total = sprint SP of the tickets reaching DoD in this sprint — same measure as the commit total. %>
        <div class="sr-kpi sr-kpi--total" title="<%= l(:text_sprint_report_dod_sp_hint) %>">
          <span class="sr-kpi__label"><%= l(:label_sprint_report_dod_sp) %></span>
          <span class="sr-kpi__value"><%= sprint_report_number(@report.actual_sp) %></span>
          <% if @report.commit_sp.to_f.positive? %>
            <span class="sr-kpi__pct"><%= l(:label_sprint_report_part_pct, pct: (@report.actual_sp.to_f * 100 / @report.commit_sp.to_f).round) %></span>
          <% end %>
        </div>
        <% [[:label_sprint_report_sp_be, @report.actual_be, @report.commit_be],
            [:label_sprint_report_sp_fe, @report.actual_fe, @report.commit_fe],
            [:label_sprint_report_sp_qa, @report.actual_qa, @report.commit_qa]].each do |label, actual, commit| %>
          <div class="sr-kpi">
            <span class="sr-kpi__label"><%= l(label) %></span>
            <span class="sr-kpi__value"><%= sprint_report_number(actual) %></span>
            <% if commit.to_f.positive? %>
              <span class="sr-kpi__pct" title="<%= l(:text_sprint_report_part_pct_hint) %>"><%= l(:label_sprint_report_part_pct, pct: (actual.to_f * 100 / commit.to_f).round) %></span>
            <% end %>
          </div>
        <% end %>
      </div>
    </section>
  </div>

  <section class="sr-card" id="sr-commit-tickets">
    <% commit_rows = @report.coded_issues.select(&:committed) %>
    <h3><%= l(:label_sprint_report_commit_tickets) %> (<%= commit_rows.size %>)</h3>
    <% if commit_rows.empty? %>
      <p class="sr-empty"><%= l(:label_no_data) %></p>
    <% else %>
      <p class="sr-hint">
        <%= l(:label_sprint_report_dod_count, count: commit_rows.count(&:dod)) %>
        ·
        <%= l(:label_sprint_report_coded_be_count, count: commit_rows.count(&:be_done)) %>
        ·
        <%= l(:label_sprint_report_coded_fe_count, count: commit_rows.count(&:fe_done)) %>
        ·
        <%= l(:label_sprint_report_coded_qa_count, count: commit_rows.count(&:qa_done)) %>
      </p>
      <div class="sr-table-wrap">
        <table class="sr-table">
          <thead>
            <tr>
              <th>#</th>
              <th><%= l(:field_tracker) %></th>
              <th><%= l(:field_subject) %></th>
              <th><%= l(:label_sprint_report_intake_source) %></th>
              <th><%= l(:label_sprint_report_dod) %></th>
              <th><%= l(:label_sprint_report_sp) %></th>
              <th><%= l(:label_sprint_report_sp_be) %></th>
              <th><%= l(:label_sprint_report_sp_fe) %></th>
              <th><%= l(:label_sprint_report_sp_qa) %></th>
              <th><%= l(:label_sprint_report_outcome) %></th>
              <th><%= l(:field_status) %></th>
              <th><%= l(:field_assigned_to) %></th>
            </tr>
          </thead>
          <tbody>
            <% commit_rows.each do |row| %>
              <% issue = row.issue %>
              <tr>
                <td class="id"><%= link_to issue.id, issue_path(issue) %></td>
                <td><%= h issue.tracker %></td>
                <td class="subject"><%= link_to_issue(issue, subject: false) %> <%= h issue.subject %></td>
                <td><%= sprint_report_intake_badge(issue, @settings) %></td>
                <td><%= sprint_report_dod_cell(row.dod) %></td>
                <td><%= sprint_report_code_cell(row.dod, row.sp, row.sp) %></td>
                <td><%= sprint_report_code_cell(row.be_done, row.be_sp, row.be_plan) %></td>
                <td><%= sprint_report_code_cell(row.fe_done, row.fe_sp, row.fe_plan) %></td>
                <td><%= sprint_report_code_cell(row.qa_done, row.qa_sp, row.qa_plan) %></td>
                <td><%= sprint_report_outcome_cell(row.outcome) %></td>
                <td><%= h issue.status %></td>
                <td><%= issue.assigned_to ? link_to_user(issue.assigned_to) : '—' %></td>
              </tr>
            <% end %>
          </tbody>
          <tfoot>
            <tr>
              <th colspan="5"><%= l(:label_total) %></th>
              <%# Sprint SP: only tickets that reached DoD in this sprint count. %>
              <th title="<%= l(:text_sprint_report_sp_total_dod_hint) %>"><%= sprint_report_number(commit_rows.select(&:dod).sum(&:sp)) %> SP</th>
              <th><%= sprint_report_number(commit_rows.select(&:be_done).sum(&:be_sp)) %> SP</th>
              <th><%= sprint_report_number(commit_rows.select(&:fe_done).sum(&:fe_sp)) %> SP</th>
              <th><%= sprint_report_number(commit_rows.select(&:qa_done).sum(&:qa_sp)) %> SP</th>
              <th colspan="3"></th>
            </tr>
          </tfoot>
        </table>
      </div>
    <% end %>
  </section>

  <section class="sr-card">
    <h3><%= l(:label_sprint_report_members) %></h3>
    <% if @report.members.empty? %>
      <p class="sr-empty"><%= l(:label_no_data) %></p>
    <% else %>
      <table class="sr-table">
        <thead>
          <tr>
            <th><%= l(:field_user) %></th>
            <th class="num"><%= l(:label_sprint_report_issue_count) %></th>
            <th class="num"><%= l(:label_sprint_report_sp) %></th>
          </tr>
        </thead>
        <tbody>
          <% @report.members.each do |row| %>
            <tr>
              <td><%= sprint_report_member_name(row) %></td>
              <td class="num"><%= row.issue_count %></td>
              <td class="num"><%= sprint_report_number(row.sp) %></td>
            </tr>
          <% end %>
        </tbody>
        <tfoot>
          <tr>
            <th><%= l(:label_total) %></th>
            <th class="num"><%= @report.members.sum(&:issue_count) %></th>
            <th class="num"><%= sprint_report_number(@report.members.sum(&:sp)) %></th>
          </tr>
        </tfoot>
      </table>
    <% end %>
  </section>

  <% intake = @report.intake %>
  <% if intake && intake[:enabled] %>
    <section class="sr-card">
      <h3><%= l(:label_sprint_report_intake) %></h3>
      <div class="sr-split">
        <div>
          <h4 class="sr-subhead"><%= l(:label_sprint_report_intake_commit) %></h4>
          <table class="sr-table">
            <thead>
              <tr>
                <th><%= l(:label_sprint_report_intake_source) %></th>
                <th class="num"><%= l(:label_issue_plural) %></th>
                <th class="num"><%= l(:label_sprint_report_sp) %></th>
              </tr>
            </thead>
            <tbody>
              <% %w[product cs sale].each do |src| %>
                <% bucket = intake[:commit][src] %>
                <tr>
                  <td><%= sprint_report_source_badge(src) %></td>
                  <td class="num"><%= bucket.count %></td>
                  <td class="num"><%= sprint_report_number(bucket.sp) %></td>
                </tr>
              <% end %>
            </tbody>
          </table>
        </div>
        <div>
          <h4 class="sr-subhead"><%= l(:label_sprint_report_intake_completed) %></h4>
          <table class="sr-table">
            <thead>
              <tr>
                <th><%= l(:label_sprint_report_intake_source) %></th>
                <th class="num"><%= l(:label_issue_plural) %></th>
                <th class="num"><%= l(:label_sprint_report_sp) %></th>
              </tr>
            </thead>
            <tbody>
              <% %w[product cs sale].each do |src| %>
                <% bucket = intake[:completed][src] %>
                <tr>
                  <td><%= sprint_report_source_badge(src) %></td>
                  <td class="num"><%= bucket.count %></td>
                  <td class="num"><%= sprint_report_number(bucket.sp) %></td>
                </tr>
              <% end %>
            </tbody>
          </table>
        </div>
      </div>

      <% if Array(intake[:quotas]).any? %>
        <h4 class="sr-subhead"><%= l(:label_sprint_report_intake_capacity) %></h4>
        <table class="sr-table">
          <thead>
            <tr>
              <th><%= l(:label_sprint_report_intake_source) %></th>
              <th class="num"><%= l(:label_sprint_report_intake_used) %></th>
              <th class="num"><%= l(:label_sprint_report_intake_quota) %></th>
              <th class="num"><%= l(:label_sprint_report_intake_remaining) %></th>
              <th class="num"><%= l(:label_sprint_report_intake_pct_commit) %></th>
            </tr>
          </thead>
          <tbody>
            <% intake[:quotas].each do |q| %>
              <tr>
                <td><%= sprint_report_source_badge(q.source) %></td>
                <td class="num"><%= sprint_report_number(q.used) %></td>
                <td class="num"><%= q.quota.nil? ? '—' : sprint_report_number(q.quota) %></td>
                <td class="num"><%= q.remaining.nil? ? '—' : sprint_report_number(q.remaining) %></td>
                <td class="num"><%= sprint_report_pct(q.pct_of_commit) %></td>
              </tr>
            <% end %>
          </tbody>
        </table>
      <% end %>
    </section>
  <% end %>

  <% if @history.present? %>
    <section class="sr-card">
      <h3><%= l(:label_sprint_report_history, count: @history.size) %></h3>
      <div class="sr-table-wrap">
        <table class="sr-table">
          <thead>
            <tr>
              <th><%= l(:label_version) %></th>
              <th class="num"><%= l(:label_sprint_report_commit) %> SP</th>
              <th class="num"><%= l(:label_sprint_report_actual) %> SP</th>
              <th class="num"><%= l(:label_sprint_report_completion_pct) %></th>
              <th class="num"><%= l(:label_sprint_report_sp_be) %></th>
              <th class="num"><%= l(:label_sprint_report_sp_fe) %></th>
              <th class="num"><%= l(:label_sprint_report_sp_qa) %></th>
            </tr>
          </thead>
          <tbody>
            <% @history.each do |row| %>
              <tr class="<%= 'is-current' if row.current %>">
                <td>
                  <% if row.current %>
                    <strong><%= h row.version.name %></strong>
                  <% else %>
                    <%= link_to h(row.version.name), project_sprint_report_path(@project, row.version) %>
                  <% end %>
                </td>
                <td class="num"><%= sprint_report_number(row.commit_sp) %></td>
                <td class="num"><%= sprint_report_number(row.actual_sp) %></td>
                <td class="num"><%= sprint_report_pct(row.completion_pct) %></td>
                <td class="num"><%= sprint_report_number(row.actual_be) %></td>
                <td class="num"><%= sprint_report_number(row.actual_fe) %></td>
                <td class="num"><%= sprint_report_number(row.actual_qa) %></td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>

      <div class="sr-charts">
        <div class="sr-chart">
          <h4 class="sr-subhead"><%= l(:label_sprint_chart_commit_actual) %></h4>
          <div class="sr-chart__canvas"><canvas id="sanan-chart-commit-actual"></canvas></div>
        </div>
        <div class="sr-chart">
          <h4 class="sr-subhead"><%= l(:label_sprint_chart_roles) %></h4>
          <div class="sr-chart__canvas"><canvas id="sanan-chart-roles"></canvas></div>
        </div>
        <div class="sr-chart">
          <h4 class="sr-subhead"><%= l(:label_sprint_chart_completion) %></h4>
          <div class="sr-chart__canvas"><canvas id="sanan-chart-completion"></canvas></div>
        </div>
        <% if @report.members.any? %>
          <div class="sr-chart">
            <h4 class="sr-subhead"><%= l(:label_sprint_chart_members) %></h4>
            <div class="sr-chart__canvas"><canvas id="sanan-chart-members"></canvas></div>
          </div>
        <% end %>
      </div>
      <script>
        if (window.renderSananSprintCharts) window.renderSananSprintCharts();
      </script>
    </section>
  <% end %>
</div>
