<% can_manage = User.current.allowed_to?(:manage_releases, @project) %>

<div class="releases-page">
  <h2>Releases</h2>

  <div class="releases-toolbar">
    <input id="rel-search" class="ui-input" placeholder="Search" value="<%= h params[:q].to_s %>" />
    <select id="rel-filter" class="ui-select">
      <option value="" <%= 'selected' if params[:state].blank? %>>All statuses</option>
      <option value="unreleased" <%= 'selected' if params[:state]=='unreleased' %>>Unreleased</option>
      <option value="released"   <%= 'selected' if params[:state]=='released' %>>Released</option>
    </select>
    <% if can_manage %>
      <button id="rel-create">Create version</button>
    <% end %>
  </div>

  <table class="releases-table <%= 'releases-table--manage' if can_manage %>">
    <thead>
      <tr>
        <th class="<%= release_sort_th_class('name') %>"><%= release_sort_link 'Version', 'name', @project %></th>
        <th class="<%= release_sort_th_class('state') %>"><%= release_sort_link 'Status', 'state', @project %></th>
        <th class="<%= release_sort_th_class('progress') %>"><%= release_sort_link 'Progress', 'progress', @project %></th>
        <th class="<%= release_sort_th_class('start_on') %>"><%= release_sort_link 'Start', 'start_on', @project %></th>
        <th class="<%= release_sort_th_class('release_on') %>"><%= release_sort_link 'Release', 'release_on', @project %></th>
        <th class="<%= release_sort_th_class('description') %>"><%= release_sort_link 'Description', 'description', @project %></th>
        <% if can_manage %>
          <th class="releases-table__actions"><%= l(:button_actions) %></th>
        <% end %>
      </tr>
    </thead>
    <tbody>
      <% @releases.each do |r| %>
        <% pill = case r.state
                 when 'released' then 'badge--released'
                 when 'archived' then 'badge--archived'
                 else 'badge--unreleased' end %>
        <tr>
          <td><%= link_to h(r.name), project_release_path(@project, r) %></td>
          <td><span class="badge <%= pill %>"><%= r.state.upcase %></span></td>
          <td><div class="bar" style="--w:<%= r.progress %>%"><span></span></div></td>
          <td><%= r.start_on || '-' %></td>
          <td><%= r.release_on || '-' %></td>
          <td class="desc-ellipsis"><%= h r.description.to_s.truncate(80) %></td>
          <% if can_manage %>
            <td class="releases-table__actions">
              <%= button_to project_release_path(@project, r, q: params[:q], state: params[:state], sort: params[:sort], direction: params[:direction]),
                  method: :delete,
                  class: 'wi-remove',
                  title: l(:button_delete),
                  form: { class: 'rel-delete-form' },
                  data: { confirm: 'Bạn có chắc muốn xóa phiên bản release này? Các issue sẽ được gỡ khỏi release (không xóa issue).' } do %>
                ×
              <% end %>
            </td>
          <% end %>
        </tr>
      <% end %>
    </tbody>
  </table>

  <div class="pagination">
    <%= pagination_links_full @releases_pages, @releases_count, per_page_links: false %>
  </div>
</div>

<div id="rel-modal" class="modal" hidden>
  <div class="modal__panel">
    <div class="modal__header">
      <h3>Create version</h3>
      <button class="modal__close">×</button>
    </div>
    <div class="modal__body" id="rel-modal-body"></div>
  </div>
</div>


<%= javascript_include_tag 'releases_index', plugin: 'sanan_redmine_agile' %>
<link rel="stylesheet" href="/plugin_assets/sanan_redmine_agile/stylesheets/releases.css">
