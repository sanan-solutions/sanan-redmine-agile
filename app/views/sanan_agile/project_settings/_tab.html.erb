<% cfg = SananAgile::ProjectSettings.load(@project.id) %>
<% issue_custom_fields = IssueCustomField.sorted.all %>
<% version_cfs = VersionCustomField.order(:name) %>
<% tracker_map  = (cfg['card_color_tracker_map']  || {}).stringify_keys %>
<% trackers     = Tracker.order(:position) %>
<% mode = (cfg['card_color_tracker_mode'].presence || 'body') %>
<%
  issue_cfs = IssueCustomField.order(:position)
  # gợi ý ưu tiên list-type trước
  sorted = issue_cfs.sort_by { |cf| cf.field_format == 'list' ? 0 : 1 }
%>

<div class="box tabular">
  <%= form_tag(project_sanan_agile_project_settings_path(@project), method: :put) do %>
    <p>
      <label><%= l(:label_enabled_for_project) %></label>
      <%= hidden_field_tag 'settings[sanan_agile_enabled]', '0' %>
      <%= check_box_tag 'settings[sanan_agile_enabled]', '1', (cfg['sanan_agile_enabled'] == '1') %>
    </p>

    <p>
      <label><%= l(:label_version_strategy) %></label>
      <%= select_tag 'settings[sanan_agile_version_strategy]',
        options_for_select([
          [l(:label_strategy_nearest_or_latest), 'nearest_due_date_or_latest_open'],
          [l(:label_strategy_latest_open), 'latest_open_only']
        ], cfg['sanan_agile_version_strategy']) %>
    </p>

    <p>
      <label><%= l(:label_skip_if_already_set) %></label>
      <%= hidden_field_tag 'settings[skip_if_already_set]', '0' %>
      <%= check_box_tag 'settings[skip_if_already_set]', '1', (cfg['skip_if_already_set'] == '1') %>
      <em><%= l(:label_skip_note) %></em>
    </p>

    <div class="setting-group">
      <h3>Working type schemes</h3>
      <p>
        <label>Epic Tracker</label>
        <%= select_tag 'settings[epic_tracker]',
              options_for_select([['– Không dùng –', '']] + Tracker.all.map { |st| [st.name, st.id] }, cfg['epic_tracker'])
              %>
      </p>

  
      <p>
        <label>Standard Trackers</label>
        <%= select_tag 'settings[standard_tracker][]',
              options_from_collection_for_select(Tracker.all, :id, :name, Array(cfg['standard_tracker'])),
              multiple: true %>
      </p>

      <p>
        <label>Sub-task Trackers</label>
        <%= select_tag 'settings[subtask_tracker][]',
              options_from_collection_for_select(Tracker.all, :id, :name, Array(cfg['subtask_tracker'])),
              multiple: true %>
      </p>

      <hr/>
      <h4>Backlog</h4>
      <p>
        <label>Enable Backlog</label>
        <%= hidden_field_tag 'settings[backlog_enabled]', '0' %>
        <%= check_box_tag 'settings[backlog_enabled]', '1', cfg['backlog_enabled'].to_s != '0' %>
      </p>
      <p>
        <label>Backlog Trackers (empty = Standard)</label>
        <%= select_tag 'settings[backlog_trackers][]',
              options_from_collection_for_select(Tracker.all, :id, :name, Array(cfg['backlog_trackers'])),
              multiple: true %>
      </p>
      <p>
        <label>Hide subtasks on Backlog</label>
        <%= hidden_field_tag 'settings[backlog_hide_subtasks]', '0' %>
        <%= check_box_tag 'settings[backlog_hide_subtasks]', '1', cfg['backlog_hide_subtasks'].to_s != '0' %>
      </p>
      
      <p>
        <label>Cho phép thêm issue con có tracker là standard vào release version</label>
        <%= hidden_field_tag 'settings[release_add_child_issue_standard_tracker]', '0' %>
        <%= check_box_tag 'settings[release_add_child_issue_standard_tracker]', '1', cfg['release_add_child_issue_standard_tracker'] == '1' %>
      </p>

      <p>
        <label>Issue status cho phép release</label>
        <%= select_tag 'settings[release_released_status_id]',
              options_from_collection_for_select(IssueStatus.sorted, :id, :name, cfg['release_released_status_id']),
              include_blank: true %>
      </p>
      <p>
        <label>Issue status sử dụng khi release version được mark released</label>
        <%= select_tag 'settings[release_close_status_id]',
              options_from_collection_for_select(IssueStatus.sorted, :id, :name, cfg['release_close_status_id']),
              include_blank: true %>
      </p>

    </div>

    <div class="setting-group">
      <div>
      <h3>Kiểu hiển thị màu thẻ (Tracker)</h3>
        <p>
          <label>
            <%= radio_button_tag 'settings[card_color_tracker_mode]', 'body', mode == 'body' %>
            Tô <strong>nền thẻ</strong> (có đổi màu chữ)
          </label>
        </p>
        <p>
          <label>
            <%= radio_button_tag 'settings[card_color_tracker_mode]', 'border', mode == 'border' %>
            Chỉ tô <strong>viền trái</strong> (giữ nền & màu chữ mặc định)
          </label>
        </p>
      </div>

        <h3>Agile card colors — theo Tracker (đè màu theo Status)</h3>
        <table class="list">
          <thead>
            <tr><th>Tracker</th><th>Màu (#RRGGBB)</th></tr>
          </thead>
          <tbody>
            <% trackers.each do |tr| %>
              <% key = tr.id.to_s %>
              <% val = tracker_map[key].presence %>
              <tr>
                <td><%= h tr.name %> (<%= tr.id %>)</td>
                <td>
                  <input type="color" value="<%= val || '#ffffff' %>" oninput="this.nextElementSibling.value=this.value">
                  <%= text_field_tag "settings[card_color_tracker_map][#{key}]", val, placeholder: '#RRGGBB', style: 'width:110px' %>
                  <span class="info">Để trống = không tô màu riêng</span>
                </td>
              </tr>
            <% end %>
          </tbody>
        </table>
        <p class="info">Ưu tiên màu: <strong>Priority</strong> &gt; <strong>Tracker</strong> &gt; <strong>Status</strong>.</p>
    </div>

    <div class="setting-group">
      <p>
        <label>Chọn Custom Field dùng làm “Test level”</label><br/>
        <%= select_tag 'settings[test_level_cfid]',
            options_for_select(
              [['-- None --', nil]] +
              sorted.map { |cf|
                label = "##{cf.id} | #{cf.name} (#{cf.field_format}#{cf.multiple ? ', multiple' : ''})"
                [label, cf.id]
              },
              cfg['test_level_cfid']
            ),
            include_blank: false %>
      </p>

      <p class="info">
        Gợi ý: nên chọn Custom Field dạng <strong>List</strong> (single hoặc multiple).
        Plugin chỉ đọc & hiển thị tag trên issue card, không chỉnh sửa dữ liệu.
      </p>
    </div>

    <div class="setting-group">
      <h3>Story point Custom Field</h3>
      <p>
        <label>Story Point – chọn Issue Custom Field</label><br/>
        <%= select_tag 'settings[story_point_cfid]',
          options_for_select([['— Không dùng —', '']] +
            issue_custom_fields.map { |cf| ["##{cf.id} — #{cf.name} (#{cf.field_format})", cf.id] },
            cfg['story_point_cfid']) %>
        <br/>
        <small>CF này sẽ được đồng bộ vào cột <code>issues.story_points</code> của Redmine Agile sau khi bạn lưu Issue.</small>
      </p>

      <p>
        <label>Story point Backend</label>
        <%= select_tag 'settings[sp_be_cfid]',
            options_for_select([['— Không dùng —','']] + issue_custom_fields.map{|cf| ["##{cf.id} — #{cf.name} (#{cf.field_format})", cf.id]},
                            cfg['sp_be_cfid']),
              include_blank: true %>
      </p>

      <p>
        <label>Story point Frontend</label>
        <%= select_tag 'settings[sp_fe_cfid]',
              options_for_select([['— Không dùng —','']] + issue_custom_fields.map{|cf| ["##{cf.id} — #{cf.name} (#{cf.field_format})", cf.id]},
                            cfg['sp_fe_cfid']),
              include_blank: true %>
      </p>

      <p>
        <label>Story point QA</label>
        <%= select_tag 'settings[sp_qa_cfid]',
              options_for_select([['— Không dùng —','']] + issue_custom_fields.map{|cf| ["##{cf.id} — #{cf.name} (#{cf.field_format})", cf.id]},
                            cfg['sp_qa_cfid']),
              include_blank: true %>
      </p>

      <hr/>
      <h4>Version CF — SP Commit (snapshot khi đóng sprint)</h4>
      <p>
        <label>SP Commit (Version CF)</label><br>
        <%= select_tag 'settings[sp_commit_version_cfid]',
            options_for_select([['-- Chọn --','']] + version_cfs.map { |cf| ["#{cf.name} (##{cf.id})", cf.id] },
                              cfg['sp_commit_version_cfid']),
            include_blank: false, class: 'select' %>
      </p>
      <p>
        <label>SP BE Commit (Version CF)</label><br>
        <%= select_tag 'settings[sp_be_commit_version_cfid]',
            options_for_select([['-- Chọn --','']] + version_cfs.map { |cf| ["#{cf.name} (##{cf.id})", cf.id] },
                              cfg['sp_be_commit_version_cfid']),
            include_blank: false, class: 'select' %>
      </p>
      <p>
        <label>SP FE Commit (Version CF)</label><br>
        <%= select_tag 'settings[sp_fe_commit_version_cfid]',
            options_for_select([['-- Chọn --','']] + version_cfs.map { |cf| ["#{cf.name} (##{cf.id})", cf.id] },
                              cfg['sp_fe_commit_version_cfid']),
            include_blank: false, class: 'select' %>
      </p>
      <p>
        <label>SP QA Commit (Version CF)</label><br>
        <%= select_tag 'settings[sp_qa_commit_version_cfid]',
            options_for_select([['-- Chọn --','']] + version_cfs.map { |cf| ["#{cf.name} (##{cf.id})", cf.id] },
                              cfg['sp_qa_commit_version_cfid']),
            include_blank: false, class: 'select' %>
      </p>

      <h4>Version CF — SP Actual (snapshot khi đóng sprint)</h4>
      <p>
        <label for="settings_sp_total_version_cfid">SP Actual (Version CF)</label><br>
        <%= select_tag 'settings[sp_actual_version_cfid]',
            options_for_select([['-- Chọn --','']] + version_cfs.map { |cf| ["#{cf.name} (##{cf.id})", cf.id] },
                              cfg['sp_actual_version_cfid']),
            include_blank: false, class: 'select' %>
      </p>

      <p>
        <label for="settings_sp_be_total_version_cfid">SP BE Actual (Version CF)</label><br>
        <%= select_tag 'settings[sp_be_actual_version_cfid]',
            options_for_select([['-- Chọn --','']] + version_cfs.map { |cf| ["#{cf.name} (##{cf.id})", cf.id] },
                              cfg['sp_be_actual_version_cfid']),
            include_blank: false, class: 'select' %>
      </p>

      <p>
        <label for="settings_sp_fe_total_version_cfid">SP FE Actual (Version CF)</label><br>
        <%= select_tag 'settings[sp_fe_actual_version_cfid]',
            options_for_select([['-- Chọn --','']] + version_cfs.map { |cf| ["#{cf.name} (##{cf.id})", cf.id] },
                              cfg['sp_fe_actual_version_cfid']),
            include_blank: false, class: 'select' %>
      </p>

      <p>
        <label for="settings_sp_test_total_version_cfid">SP QA Actual (Version CF)</label><br>
        <%= select_tag 'settings[sp_qa_actual_version_cfid]',
            options_for_select([['-- Chọn --','']] + version_cfs.map { |cf| ["#{cf.name} (##{cf.id})", cf.id] },
                              cfg['sp_qa_actual_version_cfid']),
            include_blank: false, class: 'select' %>
      </p>

      <p class="info">
        Các trường ở đây là <strong>Custom fields của Version</strong>. Hãy tạo trước ở Admin → Custom fields → Versions.
      </p>

    </div>

    <div class="setting-group">
      <h3>BE/FE Done Field</h3>


      <p>
          <label>Done Backend In Sprint (CF)</label>
          <%= select_tag 'settings[done_be_cfid]',
                options_for_select([['— Không dùng —','']] + issue_custom_fields.map{|cf| ["##{cf.id} — #{cf.name} (#{cf.field_format})", cf.id]},
                              cfg['done_be_cfid']),
                include_blank: true %>
        </p>



        <p>
          <label>Done Frontend In Sprint (CF)</label>
          <%= select_tag 'settings[done_fe_cfid]',
                options_for_select([['— Không dùng —','']] + issue_custom_fields.map{|cf| ["##{cf.id} — #{cf.name} (#{cf.field_format})", cf.id]},
                              cfg['done_fe_cfid']),
                include_blank: true %>
        </p>

        <p>
          <label>Done QA In Sprint (CF)</label>
          <%= select_tag 'settings[done_qa_cfid]',
                options_for_select([['— Không dùng —','']] + issue_custom_fields.map{|cf| ["##{cf.id} — #{cf.name} (#{cf.field_format})", cf.id]},
                              cfg['done_qa_cfid']),
                include_blank: true %>
        </p>

        <p>
          <label>Limit trackers (optional)</label>
          <%= select_tag 'settings[befe_trackers][]',
                options_from_collection_for_select(Tracker.all, :id, :name, Array(cfg['befe_trackers'])),
                multiple: true %>
          <br><small>Để trống = áp dụng tất cả tracker.</small>
        </p>

        <p>
          <label>Statuses hiển thị BE/FE footer (optional)</label><br>
          <% statuses = IssueStatus.order(:position) %>
          <%= select_tag 'settings[befe_statuses][]',
                options_from_collection_for_select(statuses, :id, :name, Array(cfg['befe_statuses']).map(&:to_i)),
                multiple: true %>
          <span class="info">Chỉ những issue đang ở các status này mới thấy 2 checkbox BE/FE.</span>
        </p>

        <hr>
        <p>
          <label>Tự động chuyển status khi đủ điều kiện</label>
          <%= hidden_field_tag 'settings[auto_move_enabled]', '0' %>
          <%= check_box_tag 'settings[auto_move_enabled]', '1', cfg['auto_move_enabled'] == '1' %>
        </p>

        <p>
          <label>Status đích</label>
          <%= select_tag 'settings[auto_move_status_id]',
                options_from_collection_for_select(IssueStatus.sorted, :id, :name, cfg['auto_move_status_id']),
                include_blank: true %>
        </p>

        <p>
          <label>Resolve status (bắt buộc Done BE/FE)</label><br>
          <% statuses = IssueStatus.order(:position) %>
          <%= select_tag 'settings[resolve_status]',
              options_from_collection_for_select(statuses, :id, :name, cfg['resolve_status'].to_s),
              include_blank: true, class: 'select' %>
          <span class="info">Khi issue chuyển sang status này, hệ thống sẽ kiểm tra Done BE/FE tương ứng với SP được set.</span>
        </p>
    </div>

    <div class="setting-group">
     <h3>Code Done field</h3>
      <p>
        <label><%= l(:label_trigger_status_name) %></label>
                 <%= select_tag 'settings[code_done_status_name]',
            options_for_select(
              [['– Không dùng –', '']] + IssueStatus.all.map { |st| [st.name, st.name] },
              cfg['code_done_status_name']
            )
          %>
          <br><small>Khi issue đổi sang status này (kéo sang cột tương ứng), plugin sẽ ghi Default Version.</small>
      </p>

      <p>
        <label><%= l(:label_custom_field_to_fill) %></label>
        <%= select_tag 'settings[code_done_cfid]',
          options_for_select([['— ' + l(:label_none) + ' (Target version)', '']] +
            issue_custom_fields.map { |cf| ["##{cf.id} — #{cf.name} (#{cf.field_format})", cf.id] }, cfg['code_done_cfid']) %>
        <br/>
        <small><%= l(:label_custom_field_help) %></small>
      </p>
    </div>


    <div class="setting-group">
     <h3>QA Done field</h3>
      <p>
        <label><%= l(:label_trigger_status_name) %></label>
                 <%= select_tag 'settings[development_done_status_name]',
            options_for_select(
              [['– Không dùng –', '']] + IssueStatus.all.map { |st| [st.name, st.name] },
              cfg['development_done_status_name']
            )
          %>
          <br><small>Khi issue đổi sang status này (kéo sang cột tương ứng), plugin sẽ ghi Default Version.</small>
      </p>

      <p>
        <label><%= l(:label_custom_field_to_fill) %></label>
        <%= select_tag 'settings[development_done_cfid]',
          options_for_select([['— ' + l(:label_none) + ' (Target version)', '']] +
            issue_custom_fields.map { |cf| ["##{cf.id} — #{cf.name} (#{cf.field_format})", cf.id] }, cfg['development_done_cfid']) %>
        <br/>
        <small><%= l(:label_custom_field_help) %></small>
      </p>
    </div>

    <div class="setting-group">
      <h3>Done field</h3>
      <p>
        <label>Trackers hiển thị checkbox "Mark is done (DoD)"</label><br/>
        <%= select_tag 'settings[dod_checkbox_trackers][]',
              options_from_collection_for_select(Tracker.all, :id, :name, cfg['dod_checkbox_trackers']),
              multiple: true %>
      </p>

      <p>
        <label>Status hiển thị checkbox "Mark is done (DoD)"</label><br/>
        <%= select_tag 'settings[dod_checkbox_statuses][]',
        options_from_collection_for_select(IssueStatus.sorted, :id, :name, Array(cfg['dod_checkbox_statuses'])),
        multiple: true %>
        <br><small>Chỉ khi Issue đang ở một trong các trạng thái này, checkbox mới xuất hiện.</small>
      </p>

      <p>
        <label>Custom Field "Mark is done (DoD)"</label><br/>
        <%= select_tag 'settings[dod_cfid]',
              options_for_select([['— Chưa chọn —','']] + IssueCustomField.all.map{|cf| ["##{cf.id} - #{cf.name}", cf.id]},
                                cfg['dod_cfid']) %>
      </p>
    </div>

    <div class="setting-group">
      <h3>UAT Done field</h3>
      <p>
        <label>UAT Done – chọn trạng thái (status)</label><br/>
          <%= select_tag 'settings[uat_done_status_name]',
            options_for_select(
              [['– Không dùng –', '']] + IssueStatus.all.map { |st| [st.name, st.name] },
              cfg['uat_done_status_name']
            )
          %>
          <br><small>Khi issue đổi sang status này (kéo sang cột tương ứng), plugin sẽ ghi Default Version.</small>
      </p>

      <p>
        <label>UAT Done – chọn Custom Field để ghi</label><br/>
        <%= select_tag 'settings[uat_done_cfid]',
            options_for_select([['— Không dùng —','']] + issue_custom_fields.map{|cf| ["##{cf.id} — #{cf.name} (#{cf.field_format})", cf.id]},
                              cfg['uat_done_cfid']) %>
        <br><small>Nếu CF là kiểu <code>Version</code> sẽ ghi ID version; nếu là Text sẽ ghi tên version.</small>
      </p>
    </div>

    <hr/>
    <div>
      <h2>Release Version Management</h2>
      <div class="setting-group">
          <p>
          <label>Hiển thị issue có status:</label>
           <%= select_tag 'settings[release_status_filter_ids][]',
        options_from_collection_for_select(IssueStatus.sorted, :id, :name, Array(cfg['release_status_filter_ids'])),
        multiple: true %>
        </p>
      </div>
    </div>



    <p><%= submit_tag l(:button_save) %></p>
  <% end %>
</div>

  <style>
    .setting-group {
      margin-top: 1rem
    }
  </style>