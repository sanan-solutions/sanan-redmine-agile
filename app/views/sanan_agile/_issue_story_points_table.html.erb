<%#
  Issue page: Size, This sprint SP (current / next sprint) and the per-sprint history — under the attributes.
  Values come from the issue custom fields (SananAgile::IssueSp); history from sanan_issue_sprint_sps.
%>
<% issue = local_assigns[:issue] || @issue %>
<% project = issue&.project %>
<% if issue && project && respond_to?(:sanan_agile_enabled_for?) && sanan_agile_enabled_for?(project) %>
  <% cfg = SananAgile::ProjectSettings.load(project.id) %>
  <% personal_only = SananAgile::SpTotalFormula.subtask?(issue, cfg) %>
  <% parts = personal_only ? [] : %i[be fe qa].select { |p| cfg["sp_#{p}_cfid"].to_i.positive? } %>
  <% size = SananAgile::IssueSp.values(issue, cfg, :size) %>
  <% sprint = SananAgile::IssueSp.values(issue, cfg, :sprint) %>
  <% size_parts = personal_only ? [] : %i[be fe qa].select { |p| SananAgile::IssueSp.cfid(cfg, :size, p).positive? } %>
  <% history = SananIssueSprintSp.where(issue_id: issue.id).includes(:version).order(captured_at: :desc).to_a %>
  <% labels = { be: :label_sprint_report_sp_be, fe: :label_sprint_report_sp_fe, qa: :label_sprint_report_sp_qa } %>
  <% kpi = lambda do |label, value|
       content_tag(:div, class: 'sanan-sp-kpi') do
         content_tag(:span, label, class: 'sanan-sp-kpi__label') + content_tag(:span, sanan_format_sp(value), class: 'sanan-sp-kpi__value')
       end
     end %>

  <div class="sanan-sp-show<%= ' sanan-sp-show--pair' unless personal_only %>">
    <% unless personal_only %>
      <div class="sanan-sp-block sanan-sp-block--compact">
        <div class="sanan-sp-block__head">
          <strong class="sanan-sp-block__title"><%= l(:label_sanan_sp_size_group) %></strong>
        </div>
        <div class="sanan-sp-kpis">
          <% size_parts.each do |p| %><%= kpi.call(l(labels[p]), size[p]) %><% end %>
          <% if SananAgile::IssueSp.cfid(cfg, :size, :total).positive? %><%= kpi.call(l(:label_sanan_sp_total), size.sp_total) %><% end %>
        </div>
      </div>
    <% end %>

    <div class="sanan-sp-block sanan-sp-block--compact">
      <div class="sanan-sp-block__head">
        <strong class="sanan-sp-block__title"><%= personal_only ? l(:label_sanan_sp_personal) : l(:label_sanan_sp_sprint_group) %></strong>
      </div>
      <div class="sanan-sp-kpis">
        <% parts.each do |p| %><%= kpi.call(l(labels[p]), sprint[p]) %><% end %>
        <%= kpi.call(personal_only ? l(:label_sanan_sp_personal) : l(:label_sanan_sp_total), SananAgile::IssueSp.total_of(sprint, cfg)) %>
      </div>
    </div>
  </div>

  <% if history.any? %>
    <div class="sanan-sp-block">
      <div class="sanan-sp-block__head">
        <strong class="sanan-sp-block__title"><%= l(:label_sanan_sp_history_group) %></strong>
      </div>
      <table class="list sanan-sp-table">
        <thead>
          <tr>
            <th><%= l(:field_version) %></th>
            <% parts.each do |p| %><th><%= l(labels[p]) %></th><% end %>
            <th><%= personal_only ? l(:label_sanan_sp_personal) : l(:label_sanan_sp_total) %></th>
          </tr>
        </thead>
        <tbody>
          <% history.each do |row| %>
            <tr class="<%= cycle('odd', 'even', name: 'sanan_sp_hist') %>">
              <td class="name"><%= row.version ? link_to(row.version.name, version_path(row.version)) : "##{row.version_id}" %></td>
              <% parts.each do |p| %><td class="value"><%= sanan_format_sp(row.public_send(:"sp_#{p}")) %></td><% end %>
              <td class="value"><%= sanan_format_sp(row.sp_total.nil? ? row.team_total : row.sp_total) %></td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  <% end %>
<% end %>
