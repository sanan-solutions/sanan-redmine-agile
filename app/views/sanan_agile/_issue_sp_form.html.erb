<%# Story points on the issue form. All values are issue custom fields (SananAgile::IssueSp):
    Size (estimate of the ticket) and This sprint (current / next sprint; re-estimated after each sprint).
    A sub-task only has its personal SP, the sprint Total. Totals default to the formula in the settings. %>
<% issue = local_assigns[:issue] || @issue %>
<% project = issue&.project || @project %>
<% if issue && project && respond_to?(:sanan_agile_enabled_for?) && sanan_agile_enabled_for?(project) %>
  <% cfg = SananAgile::ProjectSettings.load(project.id) %>
  <% available = issue.available_custom_fields.map(&:id) %>
  <% field_of = ->(group, part) { id = SananAgile::IssueSp.cfid(cfg, group, part); available.include?(id) ? id : nil } %>
  <% value_of = ->(id) { (sanan_cf_value_object_for(issue, id)&.value.presence || issue.custom_field_value(id)) } %>
  <% labels = { be: :label_sprint_report_sp_be, fe: :label_sprint_report_sp_fe, qa: :label_sprint_report_sp_qa, total: :label_sanan_sp_total } %>
  <% personal_only = SananAgile::SpTotalFormula.subtask?(issue, cfg) %>
  <% sp_formula = personal_only ? 'manual' : SananAgile::SpTotalFormula.formula(cfg) %>
  <% sp_require_qa = !personal_only && SananAgile::SpTotalFormula.require_qa?(cfg) %>
  <% all_ids = SananAgile::IssueSp::KEYS.keys.flat_map { |g| SananAgile::IssueSp.cfids(cfg, g) } %>
  <% hide_ids = all_ids + (respond_to?(:sanan_sprint_done_cf_ids_for) ? sanan_sprint_done_cf_ids_for(project) : []) %>

  <% sp_select = lambda do |id, group, role|
       sanan_sp_fibo_select("issue[custom_field_values][#{id}]", value_of.call(id),
                            id: "sanan_sp_cf_#{id}", class: 'sanan-sp-input',
                            data: { sanan_sp_role: role, sanan_sp_group: group })
     end %>

  <div class="sanan-sp-forms">
    <% if personal_only %>
      <% personal = field_of.call(:sprint, :total) %>
      <% if personal %>
        <fieldset class="sanan-sp-form" id="sanan-sp-personal-form">
          <legend><%= l(:label_sanan_sp_personal) %></legend>
          <p class="sanan-sp-form__hint"><%= l(:text_sanan_sp_personal_hint) %></p>
          <div class="sanan-sp-form__grid">
            <p>
              <label for="sanan_sp_cf_<%= personal %>"><%= l(:label_sanan_sp_personal) %></label>
              <%= sp_select.call(personal, 'personal', 'total') %>
            </p>
          </div>
        </fieldset>
      <% end %>
    <% else %>
      <% [[:size, :label_sanan_sp_size_group, :text_sanan_sp_size_hint, 'sanan-sp-size-form'],
          [:sprint, :label_sanan_sp_sprint_group, :text_sanan_sp_sprint_hint, 'sanan-sp-sprint-form']].each do |group, legend, hint, dom_id| %>
        <% ids = SananAgile::IssueSp::PARTS.to_h { |part| [part, field_of.call(group, part)] }.compact %>
        <% next if ids.empty? %>
        <fieldset class="sanan-sp-form" id="<%= dom_id %>">
          <legend><%= l(legend) %></legend>
          <p class="sanan-sp-form__hint"><%= l(hint) %></p>
          <div class="sanan-sp-form__grid">
            <% ids.each do |part, id| %>
              <p>
                <label for="sanan_sp_cf_<%= id %>"><%= l(labels[part]) %></label>
                <%= sp_select.call(id, group.to_s, part.to_s) %>
              </p>
            <% end %>
          </div>
        </fieldset>
      <% end %>
    <% end %>
  </div>

  <div id="sanan-sp-hide-cfs" hidden
       data-cf-ids="<%= hide_ids.join(',') %>"
       data-sp-formula="<%= sp_formula %>"
       data-sp-scale="<%= SananAgile::SP_FIBO.join(',') %>"
       data-sp-require-qa="<%= sp_require_qa ? '1' : '0' %>"></div>

  <%= render partial: 'sanan_agile/issue_sprint_done_form', locals: { issue: issue } %>
<% end %>
